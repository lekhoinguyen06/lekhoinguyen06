---
import Title from "../components/Title.astro";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<div class="flex flex-col items-center gap-4">
    <Title title={title} />
    <div class="flex flex-col items-baseline gap-4 max-w-2xl mb-67">
        <slot />
    </div>
</div>
