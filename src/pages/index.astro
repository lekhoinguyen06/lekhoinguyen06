---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Block from "../components/Block.astro";
import meImage from "../assets/me.jpg";
import Le from "../assets/le.svg";
import Ts from "../assets/ts.svg";
import ReactLogo from "../assets/react.svg";
import Tw from "../assets/tw.svg";
import Figma from "../assets/figma.svg";
import Svelte from "../assets/svelte.svg";
import Effect from "../assets/effect.svg";
import Cpp from "../assets/cpp.svg";
import Py from "../assets/py.svg";
import Rs from "../assets/rs.svg";
import Ocaml from "../assets/ocaml.svg";
import Ga from "../assets/ga.svg";
import Cf from "../assets/cf.svg";
import Aws from "../assets/aws.svg";
import Semver from "../assets/semver.svg";
import Npm from "../assets/npm.svg";
import Tf from "../assets/tf.svg";
import Pulumi from "../assets/pulumi.svg";
import Alchemy from "../assets/alchemy.svg";
---

<Layout>
    <Block>
        <div class="relative size-full flex sm:flex-row items-center flex-col gap-8">
            <Image
                src={meImage}
                alt="Le Khoi Nguyen"
                layout="constrained"
                width={240}
                height={420}
            />
            <div class="w-full flex flex-col gap-4 p-4">
                <div class="text-4xl font-brand">Lê Khôi Nguyên</div>
                <div>
                    “The people who are crazy enough to think they can change
                    the world are the ones who do.” – Steve Jobs
                </div>
                <div>Birthday: 06/02/2007</div>
                <div>Hometown: Hồ Chí Minh, Việt Nam</div>
                <a
                    href="mailto:khoinguyenbenz@gmail.com?subject=Hi%20Nguyen!&body=I%20saw%20your%20website"
                    class="w-fit hover:bg-blue-500 hover:text-white"
                >
                    Please contact via email at khoinguyenbenz@gmail.com
                </a>
            </div>
            <Le
                aria-label="Signature"
                height={67}
                class="absolute bottom-0 right-0"
            />
        </div>
    </Block>
    <Block title="About">
        <div class="w-full flex flex-col">
            <div class="font-semibold mb-4">Values</div>
            <li class="ml-4">
                <span class="font-bold">Authenticity.</span> I rather be myself
                than a bloated version of me. The only way to knows who loves
                you is to be you.
            </li>
            <li class="ml-4">
                <span class="font-bold">Love.</span> It is all that matters at
                the end of the day. The journey we go and the people we are
                with.
            </li>
            <li class="ml-4">
                <span class="font-bold">For what matters.</span> A better world.
                I believe our purpose, the secret to fulfillment, is to serve.
                The question always is: “How can I help?”.
            </li>
        </div>
        <div class="w-full flex flex-col">
            <div class="font-semibold mb-4">Obsessions</div>
            <li class="ml-4">
                <span class="font-bold">Ownership.</span> No ownership no
                innovation. I believe AI still only is a general machine, it
                struggles operating on the unknowns. For me, AI should only
                consult and not decide how the world is built. I still type code
                by hand because I feels like that is the rate at which I consume
                knowledge.
            </li>
            <li class="ml-4">
                <span class="font-bold">Smooth operator.</span> We are living in
                a world of abundance, it is time to care more. I am obsessed
                with observables and accessibility. I want to create softwares
                that are just easy to use.
            </li>
        </div>
    </Block>
    <Block title="Skills">
        <div class="font-semibold">Fluent</div>
        <div class="w-full flex flex-wrap gap-4 sm:gap-8">
            <Ts aria-label="Typescript" height={32} />
            <ReactLogo aria-label="React" height={32} />
            <Tw aria-label="Tailwind" height={32} />
            <Figma aria-label="Figma" height={32} />
        </div>
        <div class="font-semibold">Messed around with</div>
        <div class="w-full flex flex-col sm:flex-row flex-wrap gap-4 sm:gap-8">
            <span>Fullstack stuffs</span>
            <div class="flex flex-wrap gap-4 sm:gap-8">
                <Svelte aria-label="Svelte" height={24} />
                <Effect aria-label="Effect" height={24} />
            </div>
            <span class="hidden sm:block">|</span>
            <span>Languages</span>
            <div class="flex flex-wrap gap-4 sm:gap-8">
                <Cpp aria-label="C++" height={24} />
                <Py aria-label="Python" height={24} />
                <Rs aria-label="Rust" height={24} />
                <Ocaml aria-label="OCaml" height={24} />
            </div>
            <span class="hidden sm:block">|</span>
            <span>CI/CD</span>
            <div class="flex flex-wrap gap-4 sm:gap-8">
                <Ga aria-label="Github Actions" height={24} />
            </div>
            <span class="hidden sm:block">|</span>
            <span>IaC</span>
            <div class="flex flex-wrap gap-4 sm:gap-8">
                <Tf aria-label="Terraform" height={24} />
                <Pulumi aria-label="Pulumi" height={24} />
                <Alchemy aria-label="Alchemy" height={24} />
            </div>
            <span class="hidden sm:block">|</span>
            <span>Cloud providers</span>
            <div class="flex flex-wrap gap-4 sm:gap-8">
                <Cf aria-label="Cloudflare" height={24} />
                <Aws aria-label="Amazon Web Service" height={24} />
            </div>
        </div>
        <div class="font-semibold">Would like to be fluent in</div>
        <div>
            I believe Svelte & Effect might just be the future of the web; Rust
            is just so cool; I love publishing packages and I would love improve
            my SemVer and NPM publishing practices.
        </div>
        <div class="w-full flex flex-wrap gap-4 sm:gap-8">
            <Svelte aria-label="Svelte" height={32} />
            <Effect aria-label="Effect" height={32} />
            <Rs aria-label="Rust" height={32} />
            <Semver aria-label="SemVer" height={32} />
            <Npm aria-label="NPM" height={32} />
        </div>
    </Block>
    <Block title="History">
        <div class="w-full flex flex-col">
            <div class="font-semibold mb-4">Education</div>
            <li class="ml-4">Hồ Văn Huê Primary School - from grade 1 to 4</li>
            <li class="ml-4">Vinschool Central Park - from grade 5 to 12</li>
            <li class="ml-4">
                Ho Chi Minh Institution of Technology (HCMUT) - Bachelor of
                Computer Science - from 2025 to 2029 (expected)
            </li>
        </div>
        <div class="w-full flex flex-col">
            <div class="font-semibold mb-4">Work</div>
            <li class="ml-4">
                ECV Vietnam - Internship - from October to December of 2025
            </li>
            <li class="ml-4">
                Vstaffs - Founder (self-employed & not incorporated) - from
                January of 2026
            </li>
            <li class="ml-4">
                Walker - Author (self-employed & open-source) - from January of
                2026
            </li>
        </div>
    </Block>
    <Block title="Links">
        <div class="w-full flex flex-col">
            <li class="ml-4">
                <div>Personal website at</div>
                <a
                    href="https://lekhoinguyen.com"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://lekhoinguyen.com
                </a>
            </li>
            <li class="ml-4">
                <div>Personal papers at</div>
                <a
                    href="https://lekhoinguyen.com/papers"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://lekhoinguyen.com/papers
                </a>
            </li>
            <li class="ml-4">
                <div>Personal Linkedin profile at</div>
                <a
                    href="https://www.linkedin.com/in/lekhoinguyen"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://www.linkedin.com/in/lekhoinguyen
                </a>
            </li>
            <li class="ml-4">
                <div>Github at</div>
                <a
                    href="https://github.com/lekhoinguyen06"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://github.com/lekhoinguyen06
                </a>
            </li>
            <li class="ml-4">
                <div>Walker at</div>
                <a
                    href="https://walker.vstaffs.com"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://walker.vstaffs.com
                </a>
            </li>
            <li class="ml-4">
                <div>Vstaffs at</div>
                <a
                    href="https://vstaffs.com"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://vstaffs.com
                </a>
            </li>
            <li class="ml-4">
                <div>Bánh Mì at</div>
                <a
                    href="https://github.com/lekhoinguyen06/banhmi"
                    class="hover:bg-blue-500 hover:text-white font-light"
                >
                    https://github.com/lekhoinguyen06/banhmi
                </a>
            </li>
        </div>
    </Block>
</Layout>
